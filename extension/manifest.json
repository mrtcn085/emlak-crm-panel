{
  "manifest_version": 3,
  "name": "Emlak CRM Cloud Kaydet",
  "version": "12.0.0",
  "description": "Açık sahibinden ilanını Supabase CRM'e kaydeder.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.sahibinden.com/*", "https://*.supabase.co/*"],
  "action": {"default_popup":"popup.html", "default_title":"Emlak CRM Cloud"}
}
